# Copy this file to app/.env and fill in the values from
# Supabase dashboard → Project Settings → API Keys.
# These two are PUBLIC values (safe in the app). Never put secret keys in this file.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
