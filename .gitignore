# dependencies
node_modules/

# env files — NEVER commit real keys
.env
.env.*
!.env.example

# Expo / Metro
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Supabase local state
supabase/.temp/
supabase/.branches/

# misc
*.tsbuildinfo
.DS_Store
npm-debug.*
coverage/

# Expo generated native folders (Continuous Native Generation) and signing files
app/ios/
app/android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Generated copy of /shared for Edge Functions (scripts/sync-shared.mjs)
supabase/functions/_shared/scenic/

# Walking graph downloads (re-create with npm run graph:download)
scripts/graph/data/
scripts/transit/data/

# Generated by app/scripts/copy-map-worker.mjs (web builds)
app/public/maplibre-gl-worker.mjs

# Playwright: reports, results and the saved test sign-in (a session token: never commit)
e2e/report/
e2e/.auth/
test-results/
playwright-report/
