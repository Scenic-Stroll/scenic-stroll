# Server-side secrets for Edge Functions. NEVER commit real values.
# Deploy them with:  npx supabase secrets set --env-file supabase/functions/.env
# (copy this file to supabase/functions/.env first — it is git-ignored)

# Routing: "ors" (default, free) or "google"
ROUTING_PROVIDER=ors
ORS_API_KEY=
GOOGLE_ROUTES_API_KEY=
